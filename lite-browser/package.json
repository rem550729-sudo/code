{
  "name": "lite-browser",
  "version": "1.0.0",
  "private": true,
  "author": "Lite Browser contributors",
  "description": "Lightweight browser utility with an in-memory browsing session.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check toolbar.js",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.litebrowser.utility",
    "productName": "Desktop Helper",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
